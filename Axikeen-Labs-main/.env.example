# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Session signing
AUTH_SECRET=

# Groq (chat/voice)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reminder cron authentication (Vercel Cron)
CRON_SECRET=

# Persistent reminder database (production). When set, reminders are stored in
# hosted Postgres (Neon, Vercel Postgres, Supabase, or any Postgres). When
# unset, reminders fall back to local SQLite for development.
REMINDER_DATABASE_URL=
# Generic fallbacks also honored if REMINDER_DATABASE_URL is unset:
# DATABASE_URL=
# POSTGRES_URL=

# Local SQLite path override (development only)
# SANESPACE_DATABASE_PATH=
